<?xml version="1.0" encoding="utf-8"?>
<!--
    RecyclerView 的单张牌：
    根布局直接就是 PlayingCardView（MaterialCardView），
    宽度由 GridLayoutManager 的列数决定，高度由适配器按行数算出后设置。
-->
<cn.edu.sicnu.cardgame.view.PlayingCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_gap" />
